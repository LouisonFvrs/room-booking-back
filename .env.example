# PostgreSQL
POSTGRES_DB=gestionsalle
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Spring datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/gestionsalle
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# JWT
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# CORS : origines des fronts autorisés, séparées par des virgules
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Premier administrateur, créé uniquement si aucun employé n'existe
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Mode démonstration : crée des comptes publics et des données d'exemple, et fournit leur mot de
# passe à la page de connexion. À laisser à false sur une vraie installation.
DEMO_MODE=false
DEMO_PASSWORD=
# Remise à zéro des données de démonstration (cron Spring, heure de Paris) : chaque nuit à 3 h par défaut
DEMO_RESET_CRON=0 0 3 * * *
